{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BTC-SHIELD Input Record",
  "type": "object",
  "properties": {
    "timestamp": { "type": "string", "format": "date-time" },
    "src_ip": { "type": "string", "format": "ipv4" },
    "dst_ip": { "type": "string", "format": "ipv4" },
    "src_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "dst_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
    "txid": { "type": "string", "pattern": "^[a-fA-F0-9]{64}$" },
    "input_addresses": { "type": "string" },
    "output_addresses": { "type": "string" },
    "input_amounts": { "type": "string" },
    "output_amounts": { "type": "string" },
    "fee": { "type": "integer", "minimum": 0 },
    "script_type": { "type": "string", "enum": ["p2pkh", "p2sh", "p2wpkh", "p2wsh", "p2tr"] },
    "geo_country": { "type": "string", "minLength": 2, "maxLength": 2 },
    "asn": { "type": "string", "pattern": "^AS[0-9]+$" },
    "scenario_label": { "type": "string" }
  },
  "required": ["timestamp", "src_ip", "dst_ip", "txid", "input_addresses", "output_addresses", "input_amounts", "output_amounts", "fee", "script_type"]
}
