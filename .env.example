# ============================================================
# BTC-SHIELD Environment Configuration
# Copy this file to .env and fill in your values
# ============================================================

# --- Database ---
# For offline/Docker mode (PostgreSQL container):
DATABASE_URL=postgresql+asyncpg://btcshield:btcshield@localhost:5432/btcshield
# For Neon cloud mode:
# DATABASE_URL=postgresql+asyncpg://user:pass@ep-xyz.us-east-2.aws.neon.tech/btcshield?sslmode=require

# --- Security ---
JWT_SECRET=CHANGE_ME_TO_A_RANDOM_64_CHAR_STRING
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=480

# --- API ---
API_HOST=0.0.0.0
API_PORT=8000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# --- AI Interpretation ---
# Options: mock, gemini, openai
AI_PROVIDER=mock
AI_API_KEY=

# --- GeoIP ---
GEOIP_DATABASE_PATH=data/geoip/GeoLite2-City.mmdb

# --- Processing ---
INGESTION_BATCH_SIZE=1000
MAX_UPLOAD_SIZE_MB=500

# --- Logging ---
LOG_LEVEL=INFO

# --- Frontend (set in frontend/.env) ---
# VITE_API_BASE_URL=http://localhost:8000
